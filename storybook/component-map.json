{
  "note": "Figma component name -> React export that renders it. Used by tools/storybook_stories.py. 'matrix' = the two variant axes of the All variants grid; 'example' adds a composed, interactive story.",
  "Checkbox": { "module": "FormElements", "export": "Checkbox", "matrix": ["Checked", "State"] },
  "Radio": { "module": "FormElements", "export": "Radio", "matrix": ["Selected", "State"], "example": "<RadioGroup />", "example_imports": ["RadioGroup"] },
  "Toggle": { "module": "FormElements", "export": "Toggle", "matrix": ["Value", "State"] },
  "OTP / Cell": { "module": "FormElements", "export": "OTPCell" },
  "Input / Text": { "module": "FormElements", "export": "InputText" },
  "Input / Password": { "module": "FormElements", "export": "InputPassword" },
  "Input / Date": { "module": "FormElements", "export": "InputDate" },
  "Input / Phone": { "module": "FormElements", "export": "InputPhone" },
  "Text Area": { "module": "FormElements", "export": "TextArea" },
  "Search": { "module": "FormElements", "export": "Search" },
  "Upload Field": { "module": "FormElements", "export": "UploadField" },
  "OTP / Field": { "module": "FormElements", "export": "OTPField" },
  "Stepper": { "module": "FormElements", "export": "Stepper" },
  "Select / Dropdown": { "module": "FormElements", "export": "SelectDropdown", "matrix": ["State"] },
  "Button": { "module": "Navigation", "export": "Button", "matrix": ["Type", "State"] },
  "Icon Button": { "module": "Navigation", "export": "IconButton", "matrix": ["Type", "State"] },
  "Tabs / Item": { "module": "Navigation", "export": "TabsItem", "matrix": ["Type", "State"] },
  "Pagination / Item": { "module": "Navigation", "export": "PaginationItem" },
  "Breadcrumb / Item": { "module": "Navigation", "export": "BreadcrumbItem" },
  "Menu / Item": { "module": "Navigation", "export": "MenuItem", "matrix": ["Type", "State"] },
  "Tabs / Bar": { "module": "Navigation", "export": "TabsBar", "example": "<TabsBar Type=\"Underline\" showPanel />" },
  "Pagination": { "module": "Navigation", "export": "Pagination" },
  "Breadcrumb": { "module": "Navigation", "export": "Breadcrumb" },
  "Sidebar / Item": { "module": "Navigation", "export": "SidebarItem" },
  "Menu": { "module": "Navigation", "export": "Menu", "example": "<MenuInUse />", "example_imports": ["MenuInUse"] },
  "Sidebar": { "module": "Navigation", "export": "Sidebar" },
  "Top Bar": { "module": "Navigation", "export": "TopBar" },
  "Badge": { "module": "DataDisplay", "export": "Badge", "matrix": ["Status", "Size"] },
  "Avatar": { "module": "DataDisplay", "export": "Avatar", "matrix": ["Type", "Size"] },
  "Tooltip": { "module": "DataDisplay", "export": "Tooltip", "matrix": ["Size", "Arrow"], "example": "<TooltipInUse />", "example_imports": ["TooltipInUse"] },
  "Alert": { "module": "DataDisplay", "export": "Alert" },
  "Toast": { "module": "DataDisplay", "export": "Toast", "example": "<ToastInUse />", "example_imports": ["ToastInUse"] },
  "Modal": { "module": "DataDisplay", "export": "Modal", "example": "<ModalInUse />", "example_imports": ["ModalInUse"] }
}
